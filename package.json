{
  "name": "paparazzi-cli",
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "CLI tool to snap all the angles of your website",
  "main": "./dist/lib/index.js",
  "author": "Edward Dobson",
  "license": "MIT",
  "repository": "https://github.com/GodlikePenguin/Paparazzi",
  "keywords": [
    "puppeteer",
    "screenshot",
    "cli"
  ],
  "bin": "bin/run",
  "files": [
    "bin",
    "dist",
    "npm-shrinkwrap.json",
    "oclif.manifest.json"
  ],
  "oclif": {
    "bin": "paparazzi-cli",
    "commands": {
      "strategy": "single",
      "target": "./dist/commands/index.js"
    },
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ]
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "postbuild": "node ./scripts/update-readme.ts",
    "precommit": "npm run build && npm run lint && npm test"
  },
  "dependencies": {
    "@oclif/core": "^4.0.0",
    "@oclif/plugin-help": "^6.0.0",
    "@oclif/plugin-plugins": "^5.0.0",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.5",
    "oxlint": "^1.60.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "vitest-mock-extended": "^3.1.1"
  }
}
